# Copy to runtime/data/telegram/.env and fill in local values.
# This file is safe to commit because it contains placeholders only.

# Required when using env-based Telegram auth. Alternatively run the native CLI:
# dagent --runtime-directory ./runtime services auth telegram --bot-token <token> --user-id <numeric-id>
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Recommended if exposing the DAgent API port outside a trusted machine/network.
DAGENT_API_TOKEN=

# Optional: override the compose opencode/agent URL.
OPENCODE_SERVER_URL=http://agent:4096
