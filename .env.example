# Optional environment overrides. Prefer `dagent services enable|disable <service>`
# for service preferences in ./.settings and `dagent services auth telegram --bot-token <token> --user-id <numeric-id>`
# for Telegram credentials under ./data/telegram/credentials.json.
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=
OPENCODE_SERVER_HOSTNAME=127.0.0.1
OPENCODE_SERVER_PORT=4096
OPENCODE_SERVER_DIRECTORY=/Users/davidsnir/ai-projects/personal-agent
OPENCODE_SERVER_PRINT_LOGS=true
# OPENCODE_SERVER_AUTO_START=true
OPENCODE_SERVER_URL=http://127.0.0.1:4096
# Bounds Telegram/agent HTTP calls to opencode (maximum 600000).
OPENCODE_REQUEST_TIMEOUT_MS=120000
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_AGENT=
# OPENCODE_MODEL=
# OPENCODE_DIRECTORY=/Users/davidsnir/ai-projects/personal-agent

# GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Alternative to GOOGLE_CALENDAR_CLIENT_ID/SECRET: path to downloaded Google credentials.json.
# GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google-calendar-credentials.json
# Defaults to ./data/google-calendar/google-calendar.sqlite when unset.
# GOOGLE_CALENDAR_DB_PATH=./data/google-calendar/google-calendar.sqlite
GOOGLE_CALENDAR_SYNC_PAST_DAYS=30
GOOGLE_CALENDAR_SYNC_FUTURE_DAYS=90
GOOGLE_CALENDAR_SYNC_INTERVAL_SECONDS=60
GOOGLE_CALENDAR_AUTH_REDIRECT_PORT=0

# Defaults to ./data/whatsapp/whatsapp.sqlite when unset.
# WHATSAPP_DB_PATH=./data/whatsapp/whatsapp.sqlite
WHATSAPP_WORKER_INTERVAL_SECONDS=60
# Bounds scheduled sends separately from shorter lifecycle/read requests.
WHATSAPP_SEND_TIMEOUT_MS=120000
WHATSAPP_LIFECYCLE_TIMEOUT_MS=10000
# Finite total startup reconciliation deadline and delay between failed attempts.
WHATSAPP_STARTUP_RECONCILE_TIMEOUT_MS=30000
WHATSAPP_STARTUP_RETRY_INTERVAL_MS=1000
# Optional Compose overrides. Always set strong, independent values in production.
# WAHA_API_KEY=
# WAHA_WEBHOOK_SECRET=
WAHA_BASE_URL=http://waha:3000

# CLI API is disabled by default. In the standard compose deployment, the CLI API
# uses /runtime for Calendar OAuth state, writes remote MCP config to
# /agent-runtime/opencode.json, verifies it is agent-visible, and
# restarts the agent container after installing remote Calendar or WhatsApp MCP.
# Override these only for non-standard deployments.
# DAGENT_API_ENABLED=false
# DAGENT_API_HOSTNAME=127.0.0.1
# DAGENT_API_PORT=8000
# DAGENT_API_TOKEN=
# DAGENT_AGENT_RUNTIME_DIRECTORY=/agent-runtime
# DAGENT_AGENT_OPENCODE_CONFIG_PATH=/agent-runtime/opencode.json
# DAGENT_TELEGRAM_RUNTIME_DIRECTORY=/telegram-runtime
# DAGENT_WHATSAPP_RUNTIME_DIRECTORY=/whatsapp-runtime
# DAGENT_CALENDAR_MCP_TRANSPORT=remote
# DAGENT_CALENDAR_MCP_REMOTE_URL=http://calendar-mcp:7332/mcp
# DAGENT_WHATSAPP_MCP_TRANSPORT=remote
# DAGENT_WHATSAPP_MCP_REMOTE_URL=http://whatsapp-mcp:7333/mcp
# DAGENT_AGENT_RESTART_COMMAND=node dist/services/cli-api/src/restartDockerContainer.js dagent-agent
# Bounds each native CLI request to the control API (maximum 600000).
# DAGENT_CLI_API_TIMEOUT_MS=120000
