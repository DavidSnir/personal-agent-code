{
  "name": "personal-agent-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "DAgent": "dist/cli/src/cli.js",
    "dagent": "dist/cli/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:calendar": "tsc -p services/calendar/tsconfig.json",
    "build:cli-api": "tsc -p services/cli-api/tsconfig.json",
    "build:telegram": "tsc -p services/telegram/tsconfig.json",
    "build:whatsapp": "tsc -p services/whatsapp/tsconfig.json",
    "cli": "node dist/cli/src/cli.js",
    "start": "node dist/services/telegram/src/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.7",
    "@types/qrcode-terminal": "^0.12.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "googleapis": "^173.0.0",
    "open": "^11.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "serviceLayout": {
    "cliSource": "cli/src",
    "cliApiSource": "services/cli-api/src",
    "telegramSource": "services/telegram/src",
    "agentSource": "services/agent/src",
    "calendarSource": "services/calendar/src",
    "whatsappSource": "services/whatsapp/src",
    "shared": "shared"
  }
}
